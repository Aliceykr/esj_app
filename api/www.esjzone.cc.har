            "text": "/*\n * Template Customizer\n * Copyright 2018 rokaux\n */\n.customizer{position:fixed;top:85px;right:-260px;z-index:9030;transition:right .4s ease-in-out}.customizer.open{right:0}.customizer-toggle{position:absolute;top:0;left:-56px;width:56px;height:50px;border-top-left-radius:25px;border-bottom-left-radius:25px;background-color:#374250;color:#fff;text-align:center;cursor:pointer}.customizer-toggle>i{transition:opacity .35s;font-size:24px;line-height:50px}.customizer-toggle:hover>i{opacity:.7}.customizer-body{width:260px;padding:25px;border-bottom-left-radius:7px;background-color:#374250}.customizer-title{margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.5);font-size:14px;font-weight:500;text-transform:uppercase}.customizer-color-switch{margin-bottom:25px}.customizer-color-switch::after{display:block;clear:both;content:''}.customizer-color-switch>a{display:block;position:relative;float:left;width:32px;height:32px;margin:0 10px;border-radius:50%;color:#fff;text-decoration:none;text-align:center}.customizer-color-switch>a:nth-child(n+5){margin-top: 17px;}.customizer-color-switch>a::before{display:block;position:absolute;top:-5px;right:-5px;bottom:-5px;left:-5px;transition:border-color .3s;border:1px solid rgba(255,255,255,.4);border-radius:50%;content:''}.customizer-color-switch>a::after{transition:opacity .25s;font-family:feather-icons;font-size:18px;color:#000;line-height:30px;content:'\\f12e';opacity:0}.customizer-color-switch>a.active::before,.customizer-color-switch>a:hover::before{border-color:#fff}.customizer-color-switch>a.active::after{opacity:1}.customizer-backdrop{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background-image:url(../img/loading.gif);background-color:#fff;background-position:center;background-size:74px;background-repeat:no-repeat;z-index:9050}.customizer-backdrop.active{display:block}\n.customizer-text-switch{margin-bottom:25px}.customizer-text-switch::after{display:block;clear:both;content:''}.customizer-text-switch>a{display:block;position:relative;float:left;width:32px;height:32px;margin:0 10px;border-radius:50%;color:#fff;text-decoration:none;text-align:center}.customizer-text-switch>a::before{display:block;position:absolute;top:-5px;right:-5px;bottom:-5px;left:-5px;transition:border-color .3s;border:1px solid rgba(255,255,255,.4);border-radius:50%;content:''}.customizer-text-switch>a:hover::before{border-color:#fff}\n.scroll-to-end-btn{display:block;position:fixed;right:16px;bottom:150px;width:44px;height:44px;transition:top 400ms cubic-bezier(0.68, -0.55, 0.265, 1.55),background-color 0.3s,border-color 0.3s;border-radius:50%;background-color:rgba(0,0,0,0.3);color:#fff;font-size:18px;line-height:39px;z-index:2000;text-align:center;text-decoration:none}.scroll-to-end-btn:hover{background-color:rgba(0,0,0,0.8);color:#fff}.scroll-to-end-btn:focus,.scroll-to-end-btn:active{color:#fff}.scroll-to-end-btn.hidden{opacity:0}@media (max-width: 768px){.scroll-to-end-btn{bottom:100px;width:36px;height:36px;line-height:31px}}\n.site-menu ul {margin: 0 auto 0 200px;}\n.toolbar .btn-create{margin-left:6px;}\n.toolbar .account-msg:before{\n  content: \" \";\n  position: absolute;\n  display: block;\n  border-radius: 50%;\n  width: 10px;\n  height: 10px;\n  border-width: 1px;\n  top: 0;\n  right: 0;\n  background: #fd3995;\n}\n.form-control {border-radius: 9px;}\n.sub-menu, .toolbar-dropdown {\n  left: -200px;\n}\nbody {\n  font-size: 16px;\n}\na {\n  color:#2f6f9f;\n  text-decoration:none;\n  font-weight: 500;\n}\n.btn-default {\n  color: #333;\n  background-color: #fff;\n  border-color: #ccc;\n}\n.table th, .table td{\n  vertical-align: middle\n}\nblockquote {\n  padding: 15px 20px;\n  margin: 0 0 10px;\n  font-size: 15px;\n  border-top: 0;\n  border-bottom: 0;\n  __border-left: 5px solid rgba(0,0,0,.05);\n  background: #ececec;\n  color: #aaa;\n  font-weight: 500;\n  word-break: break-all;\n}\nblockquote:before {\n  content:'';\n}\nblockquote p {\n  padding-left: 20px;\n}\nblockquote p:before {\n  content: '\\201C';\n  font-family: Georgia, serif;\n  color: #9da9b9;\n  font-size: 40px;\n  font-weight: bold;\n  line-height: 0.8;\n  position: absolute;\n  left: 15px;\n  top: 10px;\n}\nblockquote p:after {\n  content: '\\201D';\n  font-family: Georgia, serif;\n  color: #9da9b9;\n  font-size: 40px;\n  font-weight: bold;\n  line-height: 0.6;\n  position: absolute;\n  bottom: 0;\n  padding-left: 7px;\n}\ndetails {\n  border-bottom: 1px solid rgba(0,0,0,.12);\n  margin-bottom: 20px;\n}\nsummary {\n  __list-style: none;\n  margin-bottom: 10px;\n}\n.widget {\n  margin-bottom: 20px;\n}\n.widget-categories-hot ul>li>a{\n  width:195px;\n}\n.widget-categories ul>li>span, .widget-links ul>li>span {\n  color: #606975;\n}\n.swal2-modal .swal2-content {\n  font-weight: 500;\n}\n.fr-emoticon-img {\n  padding-bottom: 4px;\n  font-size: 25px;\n}\n.breadcrumbs>li.slash {\n  font-weight: 700;\n}\n.tag:hover{\n  border-color:#0da9ef;\n  background-color:#0da9ef;\n  color:#fff !important;\n}\n.toolbar .discord {\n  display:inline-block;\n  position:relative;\n  margin-left:6px;\n  cursor:pointer;\n  vertical-align:middle;\n  text-align:center;\n  text-decoration:none;\n  width: 50px;\n}\n.toolbar .facebook {\n  display:inline-block;\n  position:relative;\n  cursor:pointer;\n  vertical-align:middle;\n  text-align:center;\n  text-decoration:none;\n  width: 47px;\n}\n.toolbar .discord>img, .toolbar .facebook>img {\n  display: block;\n  width: 100%;\n}\n.site-search .search {\n  position: absolute;\n\n  top: 50%;\n  right: 80px;\n  margin-top: -20px;\n  z-index: 5;\n}\n.site-search .search .btn-search {\n  margin-left: 10px;\n  padding-top: 4px;\n  padding-bottom: 10px;\n  padding-left: 10px;\n  display:inline-block;transition:color .25s;cursor:pointer;vertical-align:middle;\n}\n.show-tag span {\n  float: left;\n}\n.show-tag .alert {\n  padding: 24px 24px 13px 24px;\n}\n.show-tag .tag {\n  border: 1px 