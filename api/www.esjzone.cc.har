ght', '44px');\n\t\t\t}\n\t\t\t\n\t\t\t$('.form-edit .btn-send').on('click', function() {\n\t\t\t\t$('input[name=\"blacklist\"]').val($(\"#blacklist\").val())\n\t\t\t});\n\n\t\t\t$('.url').on('click', function() {\n\t\t\t\tvar temp = $('<input>');\n\t\t\t\t$('body').append(temp);\n\t\t\t\ttemp.val($(this).attr('href')).select();\n\t\t\t\tdocument.execCommand('copy');\n\t\t\t\ttemp.remove();\n\n\t\t\t\tshowSweetAlert($(this).attr('href') + \"<br>已複製網址到剪貼簿\", 2000);\n\t\t\t\treturn false;\n\t\t\t});\n\n\t\t\t\t\t\teditor['form-edit'] = new FroalaEditor(\"#form-edit\", {\n\t\t\t\tenter: FroalaEditor.ENTER_BR, \n\t\t\t\ttoolbarButtons: [['bold', 'italic', 'underline'], ['textColor', 'backgroundColor'], ['insertLink']], \n\t\t\t\tpasteDeniedAttrs: ['class', 'id', 'style', 'align'], \n\t\t\t\tpasteDeniedTags: ['xml', 'o:p', 'span', 'table', 'tbody', 'tr', 'td', 'th', 'font', 'ul', 'li'], \n\t\t\t\tplaceholderText: '', \n\t\t\t\tcharCounterMax: 200, \n\t\t\t\thtmlAllowedAttrs: ['id'], \n\t\t\t\tlinkEditButtons: ['linkEdit', 'linkRemove'], \n\t\t\t\tzIndex:2501, \n\t\t\t\theightMin: 100, \n\t\t\t\theightMax: 300\n\t\t\t});\n\t\t\t\n\t\t\t\t\t});\n\t</script>\n<script defer src=\"https://static.cloudflareinsights.com/beacon.min.js/v8c78df7c7c0f484497ecbca7046644da1771523124516\" integrity=\"sha512-8DS7rgIrAmghBFwoOTujcf6D9rXvH8xm8JQ1Ja01h9QX8EzXldiszufYa4IFfKdLUKTTrnSFXLDkUEOTrZQ8Qg==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"1705476a569c44cf8ec265cb2a37df9e\",\"r\":1,\"server_timing\":{\"name\":{\"cfCacheStatus\":true,\"cfEdge\":true,\"cfExtPri\":true,\"cfL4\":true,\"cfOrigin\":true,\"cfSpeedBrain\":true},\"location_startswith\":null}}' crossorigin=\"anonymous\"></script>\n</body>\n</html>"
